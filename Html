<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>The Confession Booth</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;0,9..144,600;1,9..144,400&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
<style>
  :root{
    --ink:#f2e9dc;
    --ink-dim:#b8ab98;
    --void:#0c0a09;
    --void-2:#151210;
    --wood:#2a1a16;
    --wood-2:#3d241d;
    --flame:#e8a33d;
    --flame-dim:#8a5a24;
    --danger:#b3453f;
    --ring-track: rgba(242,233,220,0.08);
  }
  *{box-sizing:border-box;}
  html,body{height:100%;}
  body{
    margin:0;
    min-height:100vh;
    min-height:100dvh;
    background:
      radial-gradient(ellipse 60% 50% at 50% 30%, rgba(232,163,61,0.10), transparent 60%),
      radial-gradient(ellipse 120% 100% at 50% 100%, var(--wood) 0%, var(--void) 55%),
      var(--void);
    color:var(--ink);
    font-family:'Inter',sans-serif;
    display:flex;
    align-items:center;
    justify-content:center;
    overflow:hidden;
    -webkit-font-smoothing:antialiased;
    user-select:none;
  }
  .stage{
    width:100%;
    max-width:560px;
    height:100dvh;
    max-height:900px;
    display:flex;
    flex-direction:column;
    align-items:center;
    justify-content:center;
    padding:32px 28px;
    position:relative;
  }
  .screen{
    width:100%;
    display:none;
    flex-direction:column;
    align-items:center;
    text-align:center;
    animation:rise 0.6s cubic-bezier(.16,1,.3,1);
  }
  .screen.active{display:flex;}
  @keyframes rise{
    from{opacity:0; transform:translateY(14px);}
    to{opacity:1; transform:translateY(0);}
  }
  @media (prefers-reduced-motion: reduce){
    .screen{animation:none;}
  }

  .mark{
    width:34px; height:34px;
    border:1px solid var(--flame-dim);
    border-radius:50%;
    display:flex; align-items:center; justify-content:center;
    margin-bottom:28px;
    flex-shrink:0;
  }
  .mark span{
    width:6px; height:6px; border-radius:50%;
    background:var(--flame);
    box-shadow:0 0 10px 2px rgba(232,163,61,0.6);
  }

  h1{
    font-family:'Fraunces', serif;
    font-weight:500;
    font-size:clamp(28px, 6vw, 40px);
    line-height:1.15;
    margin:0 0 14px;
    letter-spacing:-0.01em;
  }
  h1 em{font-style:italic; color:var(--flame); font-weight:400;}
  p.lede{
    color:var(--ink-dim);
    font-size:16px;
    line-height:1.6;
    max-width:38ch;
    margin:0 0 36px;
  }

  .btn{
    appearance:none;
    border:none;
    cursor:pointer;
    font-family:'Inter',sans-serif;
    font-weight:600;
    font-size:15px;
    padding:16px 34px;
    border-radius:100px;
    background:var(--flame);
    color:#20130a;
    letter-spacing:0.01em;
    transition:transform 0.15s ease, box-shadow 0.15s ease;
    box-shadow:0 8px 24px -8px rgba(232,163,61,0.5);
  }
  .btn:active{transform:scale(0.96);}
  .btn.ghost{
    background:transparent;
    color:var(--ink);
    border:1px solid rgba(242,233,220,0.22);
    box-shadow:none;
  }
  .btn.small{padding:12px 22px; font-size:14px;}
  .btn:disabled{opacity:0.4; cursor:not-allowed;}
  .row{display:flex; gap:12px; flex-wrap:wrap; justify-content:center;}

  .fine{
    color:var(--ink-dim);
    font-size:12.5px;
    line-height:1.6;
    margin-top:22px;
    max-width:34ch;
  }

  /* --- recorder ring --- */
  .ring-wrap{
    position:relative;
    width:min(62vw, 260px);
    height:min(62vw, 260px);
    margin-bottom:30px;
    flex-shrink:0;
  }
  svg.ring{transform:rotate(-90deg); width:100%; height:100%;}
  svg.ring circle{fill:none; stroke-width:3;}
  .track{stroke:var(--ring-track);}
  .progress{
    stroke:var(--flame);
    stroke-linecap:round;
    transition:stroke-dashoffset 0.2s linear;
  }
  .core-btn{
    position:absolute; inset:14%;
    border-radius:50%;
    border:none;
    cursor:pointer;
    background:radial-gradient(circle at 35% 30%, #c9564f, var(--danger) 70%);
    box-shadow:0 0 0 0 rgba(179,69,63,0.5);
    display:flex; align-items:center; justify-content:center;
    transition:transform 0.15s ease;
  }
  .core-btn:active{transform:scale(0.94);}
  .core-btn.recording{
    animation:pulse 1.8s ease-in-out infinite;
    border-radius:28px;
  }
  @keyframes pulse{
    0%,100%{box-shadow:0 0 0 0 rgba(179,69,63,0.45);}
    50%{box-shadow:0 0 0 18px rgba(179,69,63,0);}
  }
  .core-icon{width:30%; height:30%; background:#f2e9dc; border-radius:6px;}
  .core-btn:not(.recording) .core-icon{border-radius:50%;}

  .timer{
    font-family:'Fraunces', serif;
    font-size:15px;
    color:var(--ink-dim);
    letter-spacing:0.02em;
    margin-bottom:6px;
  }
  .status{
    font-size:13px;
    color:var(--flame);
    text-transform:lowercase;
    letter-spacing:0.03em;
    height:18px;
    margin-bottom:22px;
  }

  /* --- waveform --- */
  canvas#wave{
    width:100%; max-width:340px; height:56px;
    margin-bottom:8px;
  }

  /* --- effects --- */
  .effects-grid{
    display:grid;
    grid-template-columns:repeat(3, 1fr);
    gap:10px;
    width:100%;
    margin:6px 0 26px;
  }
  .fx-card{
    background:rgba(242,233,220,0.04);
    border:1px solid rgba(242,233,220,0.1);
    border-radius:16px;
    padding:16px 8px 12px;
    cursor:pointer;
    transition:border-color 0.15s ease, background 0.15s ease;
  }
  .fx-card svg{width:22px; height:22px; margin-bottom:8px; stroke:var(--ink-dim); transition:stroke 0.15s ease;}
  .fx-card .fx-name{font-size:12.5px; font-weight:500; color:var(--ink-dim); transition:color 0.15s ease;}
  .fx-card.selected{
    border-color:var(--flame);
    background:rgba(232,163,61,0.09);
  }
  .fx-card.selected svg{stroke:var(--flame);}
  .fx-card.selected .fx-name{color:var(--ink);}

  .player{
    width:100%;
    display:flex;
    align-items:center;
    gap:14px;
    background:rgba(242,233,220,0.04);
    border:1px solid rgba(242,233,220,0.1);
    border-radius:100px;
    padding:10px 10px 10px 10px;
    margin-bottom:26px;
  }
  .play-btn{
    width:44px; height:44px; border-radius:50%; flex-shrink:0;
    background:var(--flame); border:none; cursor:pointer;
    display:flex; align-items:center; justify-content:center;
  }
  .play-btn svg{width:16px; height:16px; fill:#20130a;}
  .scrub{
    flex:1; height:4px; background:var(--ring-track); border-radius:2px; position:relative; overflow:hidden;
  }
  .scrub-fill{position:absolute; inset:0; width:0%; background:var(--flame); border-radius:2px;}
  .dur{font-size:12px; color:var(--ink-dim); flex-shrink:0; min-width:34px;}

  .stepper{
    position:absolute;
    top:26px;
    display:flex;
    gap:7px;
  }
  .stepper i{width:5px; height:5px; border-radius:50%; background:rgba(242,233,220,0.18);}
  .stepper i.done{background:var(--flame);}

  .hidden{display:none !important;}

  a#dl-anchor{display:none;}
</style>
</head>
<body>

<div class="stepper" id="stepper">
  <i data-s="1"></i><i data-s="2"></i><i data-s="3"></i>
</div>

<div class="stage">

  <!-- SCREEN 1: WELCOME -->
  <section class="screen active" id="screen-welcome">
    <div class="mark"><span></span></div>
    <h1>Say what you<br>can't <em>say out loud</em>.</h1>
    <p class="lede">Step in, tell the truth, and leave your voice behind. We'll disguise it before anyone hears it — no names, no faces, just the confession.</p>
    <button class="btn" id="btn-start">Begin confession</button>
    <p class="fine">By continuing you agree your voice may be posted, disguised, on our Instagram page.</p>
  </section>

  <!-- SCREEN 2: RECORDING -->
  <section class="screen" id="screen-record">
    <div class="ring-wrap">
      <svg class="ring" viewBox="0 0 100 100">
        <circle class="track" cx="50" cy="50" r="45"></circle>
        <circle class="progress" id="ring-progress" cx="50" cy="50" r="45" stroke-dasharray="283" stroke-dashoffset="283"></circle>
      </svg>
      <button class="core-btn" id="btn-record" aria-label="Start recording">
        <div class="core-icon"></div>
      </button>
    </div>
    <div class="timer" id="timer-label">0:00 / 1:00</div>
    <div class="status" id="record-status">tap to speak</div>
    <canvas id="wave" width="340" height="56"></canvas>
    <div class="row" style="margin-top:10px;">
      <button class="btn ghost small hidden" id="btn-rerecord">Start over</button>
    </div>
  </section>

  <!-- SCREEN 3: DISGUISE + PREVIEW -->
  <section class="screen" id="screen-fx">
    <div class="mark"><span></span></div>
    <h1 style="font-size:26px; margin-bottom:6px;">Choose your <em>disguise</em></h1>
    <p class="lede" style="margin-bottom:22px;">Pick a voice. You can preview each one before you commit.</p>

    <div class="effects-grid" id="fx-grid"></div>

    <div class="player">
      <button class="play-btn" id="btn-play">
        <svg id="play-icon" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
      </button>
      <div class="scrub"><div class="scrub-fill" id="scrub-fill"></div></div>
      <div class="dur" id="dur-label">0:00</div>
    </div>

    <div class="row">
      <button class="btn ghost small" id="btn-back-record">Re-record</button>
      <button class="btn small" id="btn-confirm">Use this voice</button>
    </div>
  </section>

  <!-- SCREEN 4: DONE -->
  <section class="screen" id="screen-done">
    <div class="mark"><span></span></div>
    <h1>Your secret is<br><em>safe now</em>.</h1>
    <p class="lede">Save the file below and post it to the booth's Instagram. Then hand the laptop to the next confessor.</p>
    <div class="row" style="margin-bottom:14px;">
      <button class="btn" id="btn-download">Save recording</button>
    </div>
    <button class="btn ghost small" id="btn-restart">Start next confession</button>
  </section>

</div>

<a id="dl-anchor"></a>

<script>
(function(){
  const $ = id => document.getElementById(id);
  const screens = {
    welcome: $('screen-welcome'),
    record: $('screen-record'),
    fx: $('screen-fx'),
    done: $('screen-done')
  };
  const stepperDots = document.querySelectorAll('#stepper i');

  function showScreen(name, step){
    Object.values(screens).forEach(s => s.classList.remove('active'));
    screens[name].classList.add('active');
    stepperDots.forEach((d,i) => d.classList.toggle('done', i < step));
    document.getElementById('stepper').style.display = (name === 'welcome') ? 'none' : 'flex';
  }
  document.getElementById('stepper').style.display = 'none';

  const MAX_SECONDS = 60;
  const MIN_SECONDS = 2;

  let audioCtx = null;
  let mediaStream = null;
  let mediaRecorder = null;
  let recordedChunks = [];
  let rawArrayBuffer = null;      // original recorded bytes
  let decodedBuffer = null;       // decoded AudioBuffer (original)
  let processedBuffer = null;     // AudioBuffer after chosen effect
  let processedBlobUrl = null;
  let recordTimerInterval = null;
  let recordSeconds = 0;
  let analyser, waveDataArray, waveAnimFrame;
  let isRecording = false;
  let previewSource = null;
  let previewPlaying = false;
  let previewStartedAt = 0;
  let previewOffset = 0;
  let scrubAnimFrame = null;
  let currentEffect = 'normal';

  const ringProgress = $('ring-progress');
  const RING_CIRC = 283;

  function ensureAudioCtx(){
    if(!audioCtx){
      audioCtx = new (window.AudioContext || window.webkitAudioContext)();
    }
    if(audioCtx.state === 'suspended') audioCtx.resume();
    return audioCtx;
  }

  // ---------- SCREEN 1 -> 2 ----------
  $('btn-start').addEventListener('click', async () => {
    try{
      mediaStream = await navigator.mediaDevices.getUserMedia({ audio: true });
      showScreen('record', 1);
      setupWaveform();
    }catch(err){
      alert("This booth needs microphone access to record your confession. Please allow the microphone and try again.");
    }
  });

  // ---------- RECOR

